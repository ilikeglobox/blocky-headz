# Configure somente nas variáveis de ambiente do Netlify; nunca publique valores reais.
GUBEE_CLIENT_ID=
GUBEE_CLIENT_SECRET=
GUBEE_REDIRECT_URI=https://SEU-DOMINIO/.netlify/functions/gubee-oauth?action=callback
GUBEE_WEBHOOK_TOKEN=

# Para validar que o evento pertence ao seller autorizado, configure o ID visto no
# token OAuth, se quiser restringir também por seller.
GUBEE_SELLER_ID=
GUBEE_LOW_STOCK_THRESHOLD=3
